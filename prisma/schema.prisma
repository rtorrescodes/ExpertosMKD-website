generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth Models

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]

  // CRM Relations (ExpertosMKD)
  leads     Lead[]
  templates Template[]
  tasks     Task[]

  // Celeritas SaaS Relations
  tenantId  String?
  tenant    Tenant?    @relation("TenantUsers", fields: [tenantId], references: [id])
  auditLogs AuditLog[] @relation("AuditUser")
  prjTasks  PrjTask[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// CRM Models

enum Role {
  USER
  ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  CLOSED_WON
  CLOSED_LOST
}

model Industry {
  id        String   @id @default(cuid())
  name      String   @unique
  leads     Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id          String  @id @default(cuid())
  name        String
  email       String?
  phone       String?
  companyName String?
  websiteUrl  String?

  industryId String?
  industry   Industry? @relation(fields: [industryId], references: [id])

  state  String?
  city   String?
  status LeadStatus @default(NEW)
  source String? // e.g., "DeepSeek Scraper", "Manual"
  notes  String?    @db.Text

  // Scraped Data Extra
  socialLinks      Json?
  usesGenericEmail Boolean @default(false)
  hasWebsite       Boolean @default(true)
  isBlacklisted    Boolean @default(false)

  rating String @default("NONE") // "RED", "YELLOW", "GREEN", "NONE"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedToId String?
  assignedTo   User?      @relation(fields: [assignedToId], references: [id])
  activities   Activity[]
  tasks        Task[]
}

model Template {
  id        String  @id @default(cuid())
  name      String
  subject   String
  content   String  @db.Text
  isPdfOnly Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}

model Activity {
  id        String   @id @default(cuid())
  type      String // "EMAIL_SENT", "EMAIL_RECEIVED", "CALL", "MEETING"
  subject   String?
  content   String?  @db.Text
  createdAt DateTime @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  dueDate     DateTime
  type        String // "CALL", "MEETING", "EMAIL", "TODO"
  status      String   @default("PENDING") // "PENDING", "COMPLETED", "CANCELLED"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
}

// ==========================================
// ====== CELERITAS MULTI-TENANT SAAS =======
// ==========================================

model Tenant {
  id           String   @id @default(cuid())
  name         String   @unique
  subdomain    String   @unique
  customDomain String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  featureFlags Json @default("{}")

  users     User[]     @relation("TenantUsers")
  auditLogs AuditLog[]

  crmCompanies   CrmCompany[]
  crmPeople      CrmPerson[]
  crmOpps        CrmOpportunity[]
  crmNotes       CrmNote[]
  crmActivities  CrmActivity[]
  crmQuotes      CrmQuote[]
  apptEventTypes ApptEventType[]
  apptBookings   ApptBooking[]
  prjProjects    PrjProject[]
  ecomProducts   EcomProduct[]
  ecomOrders     EcomOrder[]

  erpAccounts     ErpAccount[]
  erpTransactions ErpTransaction[]
  erpInvoices     ErpInvoice[]

  invSuppliers  InvSupplier[]
  invItems      InvItem[]
  invMovements  InvMovement[]
  invPurchases  InvPurchase[]
  invWarehouses InvWarehouse[]

  @@index([status])
  @@index([subdomain])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  details   Json
  ipAddress String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation("AuditUser", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
}

model CrmCompany {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  domain        String?
  linkedin      String?
  annualRevenue Decimal?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  people        CrmPerson[]
  opportunities CrmOpportunity[]
  notes         CrmNote[]

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prjProjects PrjProject[]
}

model CrmPerson {
  id        String   @id @default(cuid())
  tenantId  String
  firstName String
  lastName  String
  email     String?
  phone     String?
  jobTitle  String?
  linkedin  String?
  companyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       CrmCompany?      @relation(fields: [companyId], references: [id])
  opportunities CrmOpportunity[]
  notes         CrmNote[]

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  crmActivities CrmActivity[]
  crmQuotes     CrmQuote[]
  apptBookings  ApptBooking[]
  prjProjects   PrjProject[]
  ecomOrders    EcomOrder[]
}

model CrmOpportunity {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  amount    Decimal?
  stage     String    @default("NEW")
  closeDate DateTime?
  personId  String?
  companyId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  person  CrmPerson?  @relation(fields: [personId], references: [id])
  company CrmCompany? @relation(fields: [companyId], references: [id])
  notes   CrmNote[]

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prjProjects PrjProject[]
}

model CrmNote {
  id            String   @id @default(cuid())
  tenantId      String
  content       String
  companyId     String?
  personId      String?
  opportunityId String?
  createdAt     DateTime @default(now())

  company     CrmCompany?     @relation(fields: [companyId], references: [id])
  person      CrmPerson?      @relation(fields: [personId], references: [id])
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id])

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ==========================================
// ====== CELERITAS QUOTES & ACTIVITIES ======
// ==========================================

model CrmActivity {
  id            String   @id @default(cuid())
  tenantId      String
  type          String // "NOTE", "QUOTE_SENT", "QUOTE_ACCEPTED", "EMAIL_RECEIVED"
  content       String?  @db.Text
  personId      String?
  opportunityId String?
  quoteId       String?
  createdAt     DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person CrmPerson? @relation(fields: [personId], references: [id])
  quote  CrmQuote?  @relation(fields: [quoteId], references: [id])
}

model CrmQuote {
  id          String @id @default(cuid())
  tenantId    String
  quoteNumber Int    @default(autoincrement())
  publicToken String @unique @default(uuid())
  status      String @default("DRAFT") // DRAFT, SENT, ACCEPTED, DECLINED, PAID
  template    String @default("MODERN")

  customerName  String?
  customerEmail String?

  personId String?
  person   CrmPerson? @relation(fields: [personId], references: [id])

  subtotal      Decimal @default(0)
  discountTotal Decimal @default(0)
  taxTotal      Decimal @default(0)
  grandTotal    Decimal @default(0)
  notes         String? @db.Text

  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items           CrmQuoteItem[]
  activities      CrmActivity[]
  erpTransactions ErpTransaction[]
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CrmQuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  productId   String?
  name        String
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @default(0)
  discount    Decimal @default(0)
  total       Decimal @default(0)

  quote CrmQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

// ==========================================
// ====== CELERITAS APPOINTMENTS (CAL) ======
// ==========================================

model ApptEventType {
  id              String   @id @default(cuid())
  tenantId        String
  title           String // Ej. "Corte de Cabello", "Consulta Médica"
  slug            String // Ej. "corte-cabello"
  description     String?  @db.Text
  durationMinutes Int      @default(30)
  price           Decimal? @default(0)
  isActive        Boolean  @default(true)

  availability Json @default("{}") // { monday: {start, end}, tuesday... }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings ApptBooking[]
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
}

model ApptBooking {
  id          String @id @default(cuid())
  tenantId    String
  eventTypeId String

  startTime DateTime
  endTime   DateTime

  status String @default("CONFIRMED") // PENDING, CONFIRMED, CANCELLED

  customerName    String
  customerEmail   String
  customerPhone   String?
  notes           String? @db.Text
  customResponses Json?

  personId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventType       ApptEventType    @relation(fields: [eventTypeId], references: [id])
  person          CrmPerson?       @relation(fields: [personId], references: [id])
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  erpTransactions ErpTransaction[]

  @@index([startTime])
}

// ==========================================
// ====== CELERITAS PROJECTS (ASANA/GANTT) ==
// ==========================================

model PrjProject {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  description String? @db.Text
  status      String  @default("PLANNING") // PLANNING, ACTIVE, ON_HOLD, COMPLETED

  startDate DateTime?
  endDate   DateTime?

  personId      String?
  companyId     String?
  opportunityId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks PrjTask[]

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person      CrmPerson?      @relation(fields: [personId], references: [id])
  company     CrmCompany?     @relation(fields: [companyId], references: [id])
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id])
}

model PrjTask {
  id        String @id @default(cuid())
  projectId String

  title       String
  description String? @db.Text
  status      String  @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  priority    String  @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT

  startDate DateTime?
  dueDate   DateTime?

  assignedToId String?
  dependsOnId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    PrjProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User?      @relation(fields: [assignedToId], references: [id])

  dependsOn      PrjTask?  @relation("TaskDependencies", fields: [dependsOnId], references: [id])
  dependentTasks PrjTask[] @relation("TaskDependencies")
}

// ==========================================
// ====== CELERITAS E-COMMERCE (MEDUSA) =====
// ==========================================

model EcomProduct {
  id          String  @id @default(cuid())
  tenantId    String
  title       String
  handle      String
  description String? @db.Text
  isPublished Boolean @default(true)
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants EcomVariant[]
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, handle])
}

model EcomVariant {
  id                String  @id @default(cuid())
  productId         String
  title             String
  sku               String?
  price             Decimal @default(0)
  inventoryQuantity Int     @default(0)

  product    EcomProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems EcomOrderItem[]
  invItem    InvItem?
}

model EcomOrder {
  id        String @id @default(cuid())
  tenantId  String
  displayId Int    @default(autoincrement())
  status    String @default("PENDING")

  customerName  String
  customerEmail String
  personId      String?

  subtotal Decimal @default(0)
  total    Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items           EcomOrderItem[]
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person          CrmPerson?       @relation(fields: [personId], references: [id])
  erpTransactions ErpTransaction[]
}

model EcomOrderItem {
  id        String  @id @default(cuid())
  orderId   String
  variantId String?
  title     String
  quantity  Int
  unitPrice Decimal @default(0)
  total     Decimal @default(0)

  order   EcomOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant EcomVariant? @relation(fields: [variantId], references: [id])
}

// ==========================================
// MÓDULO ERP Y FINANZAS
// ==========================================

model ErpAccount {
  id       String  @id @default(cuid())
  tenantId String
  name     String // Ej. "Banamex USD", "Stripe", "Caja Chica"
  currency String  @default("MXN")
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions ErpTransaction[]
}

model ErpTransaction {
  id        String @id @default(cuid())
  tenantId  String
  accountId String

  type     String // "INCOME", "EXPENSE"
  status   String @default("PENDING") // PENDING, PAID, CANCELLED
  category String @default("UNCATEGORIZED") // SOFTWARE, PAYROLL, SALES, etc.

  amount      Decimal  @default(0)
  description String?  @db.Text
  date        DateTime @default(now())

  // Referencias polimórficas (Opcionales) para conectar con otros módulos
  ecomOrderId   String?
  apptBookingId String?
  crmQuoteId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account     ErpAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  ecomOrder   EcomOrder?   @relation(fields: [ecomOrderId], references: [id], onDelete: SetNull)
  apptBooking ApptBooking? @relation(fields: [apptBookingId], references: [id], onDelete: SetNull)
  crmQuote    CrmQuote?    @relation(fields: [crmQuoteId], references: [id], onDelete: SetNull)
  invoice     ErpInvoice?
}

model ErpInvoice {
  id            String @id @default(cuid())
  tenantId      String
  transactionId String @unique

  status String @default("DRAFT") // DRAFT, ISSUED, PAID, CANCELLED

  customerName    String
  customerTaxId   String? // RFC / NIT
  customerAddress String? @db.Text

  pdfUrl String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transaction ErpTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

// ==========================================
// MÓDULO DE INVENTARIO (KARDEX)
// ==========================================

model InvSupplier {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  contactName String?
  email       String?
  phone       String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases InvPurchase[]
}

model InvItem {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  sku      String?
  barcode  String?

  minStockAlert Int     @default(5)
  unitCost      Decimal @default(0) // Costo promedio o de última compra

  // Soft link al Ecommerce
  ecomVariantId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ecomVariant   EcomVariant?      @relation(fields: [ecomVariantId], references: [id], onDelete: SetNull)
  stocks        InvStock[]
  movements     InvMovement[]
  purchaseItems InvPurchaseItem[]
}

model InvMovement {
  id          String @id @default(cuid())
  tenantId    String
  itemId      String
  warehouseId String

  type     String // "IN", "OUT", "ADJUSTMENT"
  quantity Int // Absolute value of movement
  reason   String // e.g. "Venta en tienda", "Merma", "Compra #123"

  referenceId String? // Optional link to EcomOrder, ApptBooking, or Purchase

  createdAt DateTime @default(now())

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item      InvItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse InvWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
}

model InvPurchase {
  id         String @id @default(cuid())
  tenantId   String
  supplierId String

  purchaseDate DateTime @default(now())
  status       String   @default("PENDING") // PENDING, RECEIVED, CANCELLED
  totalAmount  Decimal  @default(0)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier InvSupplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    InvPurchaseItem[]
}

model InvPurchaseItem {
  id         String @id @default(cuid())
  purchaseId String
  itemId     String

  quantity Int
  unitCost Decimal
  total    Decimal

  purchase InvPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     InvItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
}

model InvWarehouse {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  location  String?
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stocks    InvStock[]
  movements InvMovement[]
}

model InvStock {
  id          String @id @default(cuid())
  itemId      String
  warehouseId String
  quantity    Int    @default(0)

  updatedAt DateTime @updatedAt

  item      InvItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse InvWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([itemId, warehouseId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ MODELOS BASE ============

model Tenant {
  id            String          @id @default(cuid())
  name          String          @unique
  subdomain     String          @unique
  customDomain  String?
  status        TenantStatus    @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  // Configuración
  settings      Json            @default("{}")
  featureFlags  Json            @default("{}")
  
  // Fechas de ciclo de vida
  trialEndsAt   DateTime?
  gracePeriodEndsAt DateTime?
  cancelledAt   DateTime?
  
  // Relaciones
  users         User[]
  sessions      Session[]
  auditLogs     AuditLog[]
  
  @@index([status])
  @@index([subdomain])
}

enum TenantStatus {
  ACTIVE
  TRIAL
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  password      String?         // Hasheado con bcrypt
  name          String?
  role          UserRole        @default(MEMBER)
  tenantId      String?         // Null = super admin
  
  // Seguridad
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  // Relaciones
  tenant        Tenant?         @relation(fields: [tenantId], references: [id])
  sessions      Session[]
  auditLogs     AuditLog[]
  
  @@index([tenantId])
  @@index([email])
}

enum UserRole {
  SUPER_ADMIN    // Acceso a /hub y gestión global
  OWNER          // Dueño del tenant
  ADMIN          // Admin del tenant
  MEMBER         // Miembro regular
}

model Session {
  id            String          @id @default(cuid())
  userId        String
  tenantId      String          @default("")
  token         String          @unique
  expiresAt     DateTime
  createdAt     DateTime        @default(now())
  
  // Device info (opcional)
  userAgent     String?
  ipAddress     String?
  
  // Relaciones
  user          User            @relation(fields: [userId], references: [id])
  tenant        Tenant?         @relation(fields: [tenantId], references: [id])
  
  @@index([userId])
  @@index([token])
  @@index([tenantId])
}

model AuditLog {
  id            String          @id @default(cuid())
  tenantId      String
  userId        String?
  action        String          // "tenant.created", "user.invited", "feature.enabled"
  details       Json
  ipAddress     String?
  createdAt     DateTime        @default(now())
  
  // Relaciones
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  user          User?           @relation(fields: [userId], references: [id])
  
  @@index([tenantId])
  @@index([createdAt])
}

// ============ MODELOS DE FEATURES (opcionales) ============

// Los siguientes modelos se activan según feature flags del tenant

model CRM {
  // Activo si featureFlags.crm = true
  id            String          @id @default(cuid())
  tenantId      String
  // ... campos específicos de CRM
}

model Ecommerce {
  // Activo si featureFlags.ecommerce = true
  id            String          @id @default(cuid())
  tenantId      String
  // ... campos específicos de tienda
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

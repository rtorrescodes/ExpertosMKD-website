generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String
  challenge String
  createdAt DateTime @default(now())
}
